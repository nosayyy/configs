layout {
    gaps 16
    center-focused-column "always"

    preset-column-widths {
        proportion 0.3
        proportion 0.5
        proportion 0.7
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#747474"
    }

    border {
        off
        width 2
        active-color "#7fc8ffb9"
        inactive-color "#3b5b74b9"
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}
